<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════
         IDENTITÉ DU PROJET
         groupId    = votre organisation (comme un package Java)
         artifactId = nom du projet
         version    = version actuelle
    ═══════════════════════════════════════════════ -->
    <groupId>ma.clinique</groupId>
    <artifactId>clinique-medicale</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Clinique Médicale</name>
    <description>Application de gestion d'une clinique médicale (patients, médecins, rendez-vous)</description>

    <!-- ═══════════════════════════════════════════════
         PROPRIÉTÉS GLOBALES
         Modifiez ici la version Java ou l'encodage
    ═══════════════════════════════════════════════ -->
    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Classe principale (point d'entrée du programme) -->
        <mainClass>Main</mainClass>
        <!-- Version du connecteur MySQL, facile à mettre à jour ici -->
        <mysql.version>8.0.28</mysql.version>
    </properties>

    <!-- ═══════════════════════════════════════════════
         DÉPENDANCES
         Maven télécharge automatiquement ces bibliothèques
         depuis Maven Central (internet) la 1ère fois,
         puis les met en cache dans ~/.m2/repository
    ═══════════════════════════════════════════════ -->
    <dependencies>

        <!-- Connecteur JDBC pour MySQL
             Remplace le fichier mysql-connector-java-8.0.28.jar
             que vous deviez gérer manuellement avant -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
        </dependency>
        <!-- Apache POI pour Excel .xlsx -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- iText pour PDF -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

    </dependencies>

    <!-- ═══════════════════════════════════════════════
         BUILD : comment Maven compile et package
    ═══════════════════════════════════════════════ -->
    <build>
        <!-- Sources Java : src/main/java (convention Maven standard) -->
        <sourceDirectory>src/main/java</sourceDirectory>

        <!-- Ressources (db.properties, images, SQL…) copiées dans le JAR -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>

            <!-- ── Plugin 1 : Compilation ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- ── Plugin 2 : Fat JAR (JAR autonome avec toutes les dépendances) ──
                 Après "mvn package", vous obtenez :
                 target/clinique-medicale.jar  ← exécutable directement
                 Lancement : java -jar target/clinique-medicale.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>${mainClass}</mainClass>
                        </manifest>
                    </archive>
                    <finalName>clinique-medicale</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
